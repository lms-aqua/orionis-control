# =============================================================================
# Orionis Control — mobile API gateway configuration (EXAMPLE)
# =============================================================================
# Copy to services/mobile-api/.env and fill in real values.
# NEVER commit the filled-in file. Every value below is a placeholder.
# Startup validation (src/config/env.ts) reports precisely which are missing.
# =============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Public origin of this gateway, as reached by the iOS app. Must be HTTPS
# outside development. Used to build the OIDC redirect URI.
PUBLIC_BASE_URL=https://gateway.example.invalid

# Comma-separated custom URL schemes the iOS app may be redirected back to.
ALLOWED_APP_REDIRECT_SCHEMES=orioniscontrol

# --- session signing ---------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SIGNING_KEY=REPLACE_ME_BASE64_32_BYTES_MINIMUM
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
STREAM_TOKEN_TTL_SECONDS=120

# --- Authelia / OIDC ---------------------------------------------------------
# Issuer must expose /.well-known/openid-configuration
AUTHELIA_ISSUER_URL=https://auth.example.invalid
AUTHELIA_CLIENT_ID=orionis-control-mobile
AUTHELIA_CLIENT_SECRET=REPLACE_ME_CONFIDENTIAL_CLIENT_SECRET
# Must exactly match the redirect URI registered in Authelia.
AUTHELIA_REDIRECT_URI=https://gateway.example.invalid/api/mobile/v1/auth/callback
AUTHELIA_SCOPES=openid profile email groups
# Claim carrying group membership.
AUTHELIA_ROLE_CLAIM=groups

# --- role mapping ------------------------------------------------------------
# Comma-separated group names per role. Highest matching role wins.
ROLE_VIEWER_GROUPS=orionis-viewers
ROLE_OPERATOR_GROUPS=orionis-operators
ROLE_ADMIN_GROUPS=orionis-admins

# --- Orionis Guard upstream --------------------------------------------------
# Leave blank if not yet available. Camera routes then return a typed
# SERVICE_NOT_CONFIGURED error rather than fabricated data.
ORIONIS_INTERNAL_URL=
ORIONIS_SERVICE_TOKEN=
# go2rtc API for streams; use the bridge's go2rtc endpoint (port 1984).
# ORIONIS_INTERNAL_URL=http://wyze-bridge:1984
# Optional bridge API (port 5080) for real Wyze names/models/firmware.
ORIONIS_WYZE_BRIDGE_URL=
ORIONIS_TIMEOUT_MS=8000
# 'http' speaks the Orionis Guard contract; 'go2rtc' speaks a go2rtc API.
ORIONIS_ADAPTER=http
# Base URL of a MediaMTX HLS packager, e.g. http://orionis-hls:8888. Set this
# when the upstream is go2rtc: go2rtc's RTSP output is reliable but its HLS
# output stalls at two segments and drops the session after a few seconds, so
# HLS is repackaged by MediaMTX and relayed from there. Blank = relay go2rtc's
# own HLS.
ORIONIS_HLS_BASE_URL=
# Display names for upstreams that key cameras by an opaque id (go2rtc names its
# streams after the device id, which otherwise surfaces as "Camera 57").
# Format: id=Name|Location entries, comma separated; location optional.
#   ORIONIS_CAMERA_LABELS=57=Driveway|Outside,56=Shed|Side yard
ORIONIS_CAMERA_LABELS=

# --- AdGuard Home upstream ---------------------------------------------------
ADGUARD_INTERNAL_URL=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
ADGUARD_TIMEOUT_MS=8000

# --- camera connections ------------------------------------------------------
# Sources added from the app (Frigate, UniFi Protect, Tapo, Reolink, Dahua/Amcrest,
# Hikvision, Axis, Foscam, VIVOTEK, ONVIF, Wyze, Nest, RTSP, Scrypted, lostblink)
# instead of from the variables above. Their credentials are stored
# encrypted under this key, so leaving it blank switches the feature off rather
# than storing them in the clear: the routes then answer SERVICE_NOT_CONFIGURED.
#   openssl rand -base64 48
CONNECTIONS_SECRET_KEY=
# Decrypt-only, so the key can be rotated without orphaning stored credentials.
# Set the old key here, restart, run `npm run secrets:rewrap`, then remove it.
CONNECTIONS_SECRET_KEY_PREVIOUS=
# How long a recorded probe is trusted before a source is checked again.
CONNECTIONS_PROBE_TTL_SECONDS=60
# Shared with the host-side bridge applier (deploy/provisioning). Blink and Wyze
# need a helper container running beside the gateway; setting this lets the app
# ask for one. The gateway writes a file naming one of the applier's vetted
# templates — it never gets the Docker socket. Blank means this deployment
# cannot provision, and the app hides the option rather than offering something
# that can only fail.
CONNECTIONS_PROVISIONING_DIR=
# Ceiling on bridge instances, so a loop cannot fill the host with containers.
CONNECTIONS_MAX_BRIDGES=8

# --- persistence -------------------------------------------------------------
# file: path, or :memory: for tests
DATABASE_URL=./data/orionis-control.db

# --- APNs --------------------------------------------------------------------
# Leave blank to run with push disabled; registration endpoints still work and
# report push as unconfigured rather than silently discarding tokens.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.lostmediastudios.orioniscontrol
# PEM contents of the .p8, newlines escaped as \n, or APNS_PRIVATE_KEY_PATH.
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=

# --- rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_SENSITIVE_MAX=10

# --- TURN relay (WebRTC) -----------------------------------------------------
# The media relay is reachable from any network. It is not protected by an IP
# allowlist -- that would break the app on cellular -- but by credentials the
# gateway mints per session for an authenticated user, which expire in minutes and
# cannot be forged without the secret below. The relay is additionally configured
# to forward only to the media server, so a valid credential still cannot be used
# as an open relay. Leave TURN_URLS empty to disable WebRTC entirely.
TURN_URLS=
TURN_STATIC_AUTH_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=300

# --- recordings storage and retention ----------------------------------------
# Read-only mount of the recorder's volume. Without it, storage figures are
# reported as unknown rather than estimated.
ORIONIS_RECORDINGS_PATH=
ORIONIS_RECORDING_EXCLUDE=LostPrinter
# Directory shared with a host-side applier, used to request a retention change.
# The gateway writes one small file here and nothing else: actually applying it
# means restarting the recorder, which would need the Docker socket — root on the
# host, refused by ADR 0003/0005. Empty makes retention read-only in the app.
ORIONIS_RETENTION_DIR=

# --- infrastructure management (Caddy + Authelia) -----------------------------
# The gateway proxies to a self-hosted Caddy manager rather than editing Caddy or
# Authelia itself: doing that here would need the Docker socket or write access to
# Authelia's secrets, both refused by ADR 0003/0005. Empty disables the feature.
# Administrator-only (infra.view / infra.manage) and fully audited.
CADDYMANAGER_BASE_URL=
CADDYMANAGER_API_KEY=
# The internal upstream this gateway is served from. Used to refuse any Caddy
# config that would stop routing to it — which would disconnect the app from the
# only tool able to undo the change.
GATEWAY_UPSTREAM=orionis-mobile-api:8080
