# --- secrets: never commit real values ---
.env
.env.*
!.env.example
*.p8
*.p12
# Local deploy staging: image tarballs, real (non-.example) env files, compose
# overrides with live secrets. This is a build-and-ship scratch area — its
# contents (server-mobile.env, *.tar, overrides) must never reach this public repo.
/deploy/
*.mobileprovision
*.cer
*.certSigningRequest
secrets/
ExportOptions.plist
Config/*.xcconfig
!Config/*.xcconfig.example
*.xcconfig
!*.xcconfig.example

# --- local-only technical documentation (never published) ---
.ai-local/
docs/
CONTRIBUTING.md
SECURITY.md
CHANGELOG.md

# --- AI handoffs, plans, and working notes (never published) ---
*_HANDOFF.md
*_PLAN.md
*_PROGRESS.md
*_NOTES.md
!apps/ios/RELEASE_NOTES.md
AI_CONTEXT.md
CLAUDE.md
CODEX.md

# Generated local code-graph analysis
graphify-out/

# --- node ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
.vitest/
test-results/

# --- data ---
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
data/

# --- apple ---
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.xcarchive
*.ipa
*.dSYM.zip
.swiftpm/
# Scoped to the iOS tree so it does not collide, under case-insensitive git on
# Windows/macOS, with the root packages/ directory that holds the API contract.
/apps/ios/**/Packages/
xcuserdata/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
mock-preview.html
settings-mock-all-screens.html
