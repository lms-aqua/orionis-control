// Copy to Development.xcconfig and fill in. The real files are gitignored.
// Nothing secret belongs here — these values ship inside the app binary.
// The OAuth client is PUBLIC (PKCE); it has no client secret by design.

ORIONIS_API_BASE_URL = https:/$()/gateway.dev.example.invalid
ORIONIS_OAUTH_CLIENT_ID = orionis-control-mobile
ORIONIS_OAUTH_REDIRECT_SCHEME = orioniscontrol
ORIONIS_BUILD_ENVIRONMENT = development

// Note on the `/$()/` idiom: xcconfig treats `//` as a comment, so a URL must
// be escaped this way. It resolves to a normal `https://` at build time.
